# Web reads the Convex URL from Vite's import.meta.env.
# Mirror the root .env.local value here (or symlink), then `pnpm dev:web`.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_OPENBOOK_AUTH_MODE=convex-auth
VITE_CLERK_PUBLISHABLE_KEY=

# Local dev preload. Runs in Vite dev builds, and in bundles built with
# VITE_OPENBOOK_DEV_LOGIN=1. The flag is only for deliberate local experiments.
# A deployed web, desktop, or mobile build must never set it.
VITE_OPENBOOK_AUTO_LOGIN=0
VITE_OPENBOOK_DEV_EMAIL=dev@openbook.local
VITE_OPENBOOK_DEV_PASSWORD=openbook-local-dev

# Bakes the dev identity into a bundled build. Must be exactly 1. Never ship it.
VITE_OPENBOOK_DEV_LOGIN=0

# Production metadata and optional error ingestion. The release must match the
# exact Git commit used for the deployment.
VITE_OPENBOOK_RELEASE=dev
VITE_OPENBOOK_ENV=development
# Set to CONVEX_SITE_URL/client-errors in production.
VITE_OPENBOOK_ERROR_REPORT_URL=
VITE_OPENBOOK_BILLING_MODE=disabled
