{
  "name": "openbook",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Openbook — realtime social network (Vite + React web) on a single Convex backend",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -n convex,web -c magenta,cyan \"pnpm dev:backend\" \"pnpm dev:web\"",
    "dev:backend": "convex dev",
    "dev:web": "pnpm --filter web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "selfhost": "bash scripts/dev-selfhost.sh",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:publication": "GO111MODULE=off go test ./tools/... && pnpm typecheck && pnpm test && pnpm build && go run ./tools/license-audit/main.go && gitleaks git --no-banner --redact . && gitleaks dir --no-banner --redact .",
    "export:publication": "go run ./tools/publication-export/main.go",
    "go-live-check": "bash scripts/go-live-check.sh",
    "auth:setup": "node node_modules/@convex-dev/auth/dist/cli/index.js"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "convex-test": "^0.0.56",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2",
    "vite": "8.2.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "convex": "^1.44.0",
    "web-push": "^3.6.7"
  }
}
