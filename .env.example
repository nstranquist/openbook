# Openbook — web env contract.
# Copy to .env.local and fill in. `npx convex dev` writes CONVEX_DEPLOYMENT
# and the deployment URL for you.

# Convex backend (written by `npx convex dev`)
CONVEX_DEPLOYMENT=

# Client-exposed Convex URL (Vite)
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Local Convex Auth signing key (run `pnpm auth:setup` to generate)
CONVEX_AUTH_PRIVATE_KEY=

# Production identity. Set these values in the operator shell before the
# readiness check. Set the backend values on the Convex deployment too.
OPENBOOK_ENV=development
OPENBOOK_RELEASE=dev
OPENBOOK_AUTH_MODE=convex-auth
OPENBOOK_SYNTHETIC_KEY=
CLIENT_ERROR_HASH_SECRET=
CONVEX_SITE_URL=

# Email — set on the Convex deployment, not in .env.local. Production Clerk
# owns identity verification and recovery; Openbook uses Resend for application
# delivery.
#   npx convex env set EMAIL_PROVIDER resend
#   npx convex env set RESEND_API_KEY re_...
#   npx convex env set EMAIL_FROM "Openbook <hi@yourdomain.com>"

# --- Local auth OAuth and optional production billing ---
# OAuth applies only to the local Convex Auth path. Production identity settings
# live in Clerk.
#   npx convex env set AUTH_GITHUB_ID ...   AUTH_GITHUB_SECRET ...
#   npx convex env set AUTH_GOOGLE_ID ...   AUTH_GOOGLE_SECRET ...
# Stripe billing (optional; delete convex/billing.ts + BillingPanel for a free app).
# TEST mode until launch — use sk_test_/whsec_/price_; create the Pro price once
# (stripe prices create --unit-amount 900 --currency usd -d recurring[interval]=month).
#   npx convex env set STRIPE_SECRET_KEY sk_test_...
#   npx convex env set STRIPE_WEBHOOK_SECRET whsec_...      # from `stripe listen` / the dashboard endpoint
#   npx convex env set STRIPE_PRICE_PRO price_...
#   npx convex env set SITE_URL http://localhost:5173       # required for checkout return URLs
# Media CDN HMAC. Production requires an independent random value with at least
# 32 characters. Development can use the local fallback.
#   npx convex env set MEDIA_SIGNING_SECRET a-long-random-string
# Web push (optional):
#   node scripts/gen-vapid.mjs
#   npx convex env set VAPID_PUBLIC_KEY … VAPID_PRIVATE_KEY …
# Operator report queue (required in production):
#   npx convex env set OPERATOR_USER_IDS user_…
# Production feature decisions. Each mode must be explicit.
OPENBOOK_BILLING_MODE=disabled
OPENBOOK_PUSH_MODE=disabled
OPENBOOK_CAPACITY_PROFILE=launch

# Launch permits a verified daily or hourly backup. Scale requires hourly.
# Set these only after the provider controls are active and verified.
OPENBOOK_BACKUP_POLICY=
OPENBOOK_OBSERVABILITY_MODE=

# Production email verification and password recovery.
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=

# Convex Auth keys are for local development only. Production uses Clerk.
JWT_PRIVATE_KEY=
JWKS=

# Stable production authentication. Use the production Clerk instance and its
# custom Frontend API domain. Do not use pk_test_ or sk_test_ at launch.
CLERK_JWT_ISSUER_DOMAIN=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_OPENBOOK_AUTH_MODE=convex-auth

# Stripe live mode. Leave these empty when OPENBOOK_BILLING_MODE=disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Web push. Leave these empty when OPENBOOK_PUSH_MODE=disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Required production media key and moderation operators.
MEDIA_SIGNING_SECRET=
OPERATOR_USER_IDS=

# The web error sink receives bounded, redacted client failure envelopes.
VITE_OPENBOOK_ERROR_REPORT_URL=
# Then: bash scripts/go-live-check.sh   # preflight before launch
# For an incomplete counter migration, drain writes before you set:
#   OPENBOOK_MIGRATION_TRAFFIC_DRAINED=I_UNDERSTAND
# Hosted deploy (human-gated): OPENBOOK_DEPLOY=I_UNDERSTAND bash scripts/deploy.sh
