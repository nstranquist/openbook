# Openbook — web env contract.
# Copy to .env.local and fill in. `npx convex dev` writes CONVEX_DEPLOYMENT
# and the deployment URL for you.

# Convex backend (written by `npx convex dev`)
CONVEX_DEPLOYMENT=

# Client-exposed Convex URL (Vite)
VITE_CONVEX_URL=

# Convex Auth signing key (run `pnpm auth:setup` to generate)
CONVEX_AUTH_PRIVATE_KEY=

# Email (convex/emails.ts action) — set these on the Convex deployment, not in
# .env.local. Pick your provider: resend | ses | smtp.
#   npx convex env set EMAIL_PROVIDER resend
#   npx convex env set RESEND_API_KEY re_...
#   npx convex env set EMAIL_FROM "Openbook <hi@yourdomain.com>"

# --- SaaS kit (auth OAuth + Stripe billing) — set on the DEPLOYMENT, not here ---
# OAuth (optional; password sign-in works without it). See SAAS-KIT.md.
#   npx convex env set AUTH_GITHUB_ID ...   AUTH_GITHUB_SECRET ...
#   npx convex env set AUTH_GOOGLE_ID ...   AUTH_GOOGLE_SECRET ...
# Stripe billing (optional; delete convex/billing.ts + BillingPanel for a free app).
# TEST mode until launch — use sk_test_/whsec_/price_; create the Pro price once
# (stripe prices create --unit-amount 900 --currency usd -d recurring[interval]=month).
#   npx convex env set STRIPE_SECRET_KEY sk_test_...
#   npx convex env set STRIPE_WEBHOOK_SECRET whsec_...      # from `stripe listen` / the dashboard endpoint
#   npx convex env set STRIPE_PRICE_PRO price_...
# Then: bash scripts/go-live-check.sh   # preflight before launch
